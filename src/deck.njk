---
layout: layouts/base.njk
title: Sales Deck | Misterio Color Lab
---

<link rel="stylesheet" href="/css/deck.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<div class="deck-container">
    <div class="film-grain"></div>

    <!-- Section 1: Hero -->
    <section class="deck-section hero-slide" id="deck-hero-bg">
        <div class="slide-bg-wrapper">
             <div class="slide-bg" id="hero-bg-img"></div>
        </div>
        <div class="overlay-vignette"></div>
        <div class="deck-content section-inner">
            <div class="hero-logo-wrapper reveal-gsap">
                <img src="/img/logo_white_hq.png" alt="Misterio Color Lab">
            </div>
            <h1 class="reveal-gsap" id="deck-hero-title"></h1>
            <div class="hero-divider reveal-gsap"></div>
            <p class="reveal-gsap" id="deck-hero-subtitle"></p>
            <div class="scroll-indicator reveal-gsap">
                <span>SCROLL TO EXPLORE</span>
                <div class="mouse"></div>
            </div>
        </div>
    </section>

    <!-- Section 2: Services -->
    <section class="deck-section services-slide">
        <div class="slide-bg-wrapper">
             <div class="slide-bg" style="background-image: url('/img/projects/GOLD_RUN.jpg'); opacity: 0.15;"></div>
        </div>
        <div class="container section-inner">
            <h2 class="section-title reveal-gsap">Our Expertise</h2>
            <div class="services-wrapper detailed-grid" id="deck-services-grid">
                <!-- Injected via JS -->
            </div>
        </div>
    </section>

    <!-- Talent Slides -->
    <div id="deck-talents-wrapper"></div>

    <!-- Section: Showreel -->
    <section class="deck-section showreel-slide" id="deck-showreel-section" style="display:none;">
        <div class="slide-bg-wrapper">
             <div class="slide-bg" style="background-color: #000; opacity: 0.8;"></div>
        </div>
        <div class="container section-inner">
            <h2 class="section-title reveal-gsap" style="margin-bottom: 2rem;">Showreel</h2>
            <div class="video-container-premium reveal-gsap" id="deck-showreel-container">
                 <!-- Injected via JS -->
            </div>
        </div>
    </section>

    <!-- Section 6: Closing -->
    <section class="deck-section closing-slide">
        <div class="slide-bg-wrapper">
             <div class="slide-bg" style="background-image: url('/img/projects/KONVOI.jpg'); opacity: 0.25;"></div>
        </div>
        <div class="deck-content section-inner reveal-gsap">
            <h2 class="closing-title">LET'S COLOR YOUR VISION</h2>
            <p>A boutique experience for world-class projects.</p>
            <div class="cta-group">
                <a href="/#contact-form" class="deck-btn-premium">GET IN TOUCH</a>
            </div>
        </div>
    </section>
</div>

<script src="/js/cms-settings.js"></script>
<script>
    document.body.classList.add('deck-active');
    gsap.registerPlugin(ScrollTrigger);

    async function initDeck() {
        console.group("Sales Deck Debugger");
        console.log("1. Init Started");
        
        try {
            const data = await window.CMS.loadSettings();
            console.log("2. CMS Data Fetched:", data);
            
            let deck = data.deckData;
            
            if (!deck) {
                console.warn("3. deckData missing from loadSettings, trying manual fetch...");
                const res = await fetch('/data/settings/deck.json?cb=' + Date.now());
                if (!res.ok) throw new Error("Manual fetch failed with status " + res.status);
                deck = await res.json();
                console.log("3b. Manual Deck Data Fetched:", deck);
            }

            if (deck) {
                renderDeck(deck);
                console.log("4. Render success");
            } else {
                throw new Error("No deck data available from any source");
            }
        } catch (err) {
            console.error("FATAL: Deck initialization failed:", err);
            document.getElementById('deck-services-grid').innerHTML = '<p style="color:red; font-size: 1.5rem; text-align: center; width: 100%;">Error loading content. Please refresh.</p>';
        }
        console.groupEnd();
    }

    function renderDeck(deck) {
        const fixPath = (p) => {
            if (!p) return '';
            if (p.startsWith('http') || p.startsWith('/') || p.startsWith('data:')) return p;
            return '/' + p;
        };

        // 1. Hero
        try {
            document.getElementById('hero-bg-img').style.backgroundImage = `url('${fixPath(deck.hero.image)}')`;
            document.getElementById('deck-hero-title').innerHTML = deck.hero.title;
            document.getElementById('deck-hero-subtitle').innerText = deck.hero.subtitle;
        } catch(e) { console.warn("Hero render fail:", e); }

        // 2. Services
        try {
            const servicesGrid = document.getElementById('deck-services-grid');
            servicesGrid.innerHTML = deck.services.map((s, i) => `
                <div class="service-slide-item reveal-gsap">
                    <div class="service-icon-box"><span class="service-number">0${i+1}</span></div>
                    <div class="service-text">
                        <h3>${s.title}</h3>
                        <p>${s.description}</p>
                    </div>
                </div>
            `).join('');
        } catch(e) { console.warn("Services render fail:", e); }

        // 3. Talents
        try {
            const talentsWrapper = document.getElementById('deck-talents-wrapper');
            const talentKeys = ['raul', 'fady', 'cem'];
            talentsWrapper.innerHTML = talentKeys.map((key, index) => {
                if (!deck.sections || !deck.sections[key]) return '';
                const t = deck.sections[key];
                const isFlipped = index % 2 !== 0;
                return `
                    <section class="deck-section talent-slide ${key}-slide" style="z-index: ${10 + index}">
                        <div class="slide-bg-wrapper">
                             <div class="slide-bg" style="background-image: url('${fixPath(t.project_image)}');"></div>
                        </div>
                        <div class="overlay-grad ${isFlipped ? 'inverse' : ''}"></div>
                        <div class="talent-flex container section-inner ${isFlipped ? 'flipped' : ''}">
                            <div class="talent-photo reveal-gsap">
                                <div class="photo-frame">
                                    <img src="${fixPath(t.photo) || '/img/logo_white.png'}" alt="${t.name}">
                                </div>
                            </div>
                            <div class="talent-info reveal-gsap">
                                <span class="talent-label">KEY TALENT</span>
                                <h2>${t.name}</h2>
                                <h3 class="role-tag">${t.role}</h3>
                                <div class="bio-box">
                                    <p>${t.bio}</p>
                                </div>
                                <div class="key-works">
                                    <h4>SELECTED FILMOGRAPHY</h4>
                                    <div class="works-tags">
                                        ${t.works ? t.works.map(w => `<span class="work-tag">${w.item || w}</span>`).join('') : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                `;
            }).join('');
        } catch(e) { console.warn("Talents render fail:", e); }

        // 4. Showreel
        try {
            const showreelSection = document.getElementById('deck-showreel-section');
            if (deck.showreel && deck.showreel.url) {
                showreelSection.style.display = 'block';
                const videoContainer = document.getElementById('deck-showreel-container');
                
                videoContainer.innerHTML = `
                    <div class="showreel-thumb-wrapper" style="background-image: url('${fixPath(deck.showreel.thumbnail) || '/img/projects/LA_ESPERA.jpg'}');">
                        <div class="showreel-overlay">
                            <h3 class="showreel-title">${deck.showreel.title || 'REEL - MISTERIO'}</h3>
                        </div>
                        <div class="play-icon-large">
                             <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                    </div>
                `;

                videoContainer.onclick = () => {
                    if (window.openProjectModal) {
                        window.openProjectModal({
                            title: deck.showreel.title || 'REEL - MISTERIO',
                            category: 'Showreel',
                            video: deck.showreel.url,
                            director: 'Misterio Color Lab',
                            synopsis: 'A showcase of our cinematic color grading and post-production work.'
                        });
                    }
                };
            }
        } catch(e) { console.warn("Showreel render fail:", e); }

        function getEmbedUrl(url) {
            if (url.includes('youtube.com') || url.includes('youtu.be')) {
                const id = url.includes('v=') ? url.split('v=')[1].split('&')[0] : url.split('/').pop().split('?')[0];
                return `https://www.youtube.com/embed/${id}?autoplay=0&rel=0&modestbranding=1&controls=1`;
            }
            if (url.includes('vimeo.com')) {
                const id = url.split('/').pop();
                return `https://player.vimeo.com/video/${id}`;
            }
            return url;
        }

        setTimeout(initAnimations, 100);
    }

    function initAnimations() {
        console.log("5. Initializing GSAP Animations");
        // Initial load animation
        gsap.from(".hero-slide .reveal-gsap", {
            opacity: 0, y: 30, duration: 1.5, stagger: 0.2, ease: "power3.out"
        });

        // Scroll Trigger animations
        document.querySelectorAll('.deck-section').forEach(section => {
            const reveals = section.querySelectorAll('.reveal-gsap');
            if (reveals.length > 0) {
                // Pre-set visibility to ensure they don't remain hidden
                gsap.set(reveals, { opacity: 1, y: 0 }); 
                
                gsap.from(reveals, {
                    scrollTrigger: {
                        trigger: section,
                        start: "top 90%",
                        scroller: ".deck-container",
                        toggleActions: "play none none none"
                    },
                    opacity: 0, y: 30, duration: 1, stagger: 0.15, ease: "power2.out"
                });
            }

            const bg = section.querySelector('.slide-bg');
            if (bg) {
                gsap.to(bg, {
                    scrollTrigger: {
                        trigger: section,
                        start: "top bottom", end: "bottom top", scrub: true, scroller: ".deck-container"
                    },
                    y: "10%", ease: "none"
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initDeck);
</script>
