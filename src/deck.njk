---
layout: layouts/base.njk
title: Sales Deck | Misterio Color Lab
permalink: /deck/
---

<link rel="stylesheet" href="/css/deck.css">

<div class="deck-container">
    <!-- Section 1: Hero -->
    <section class="deck-section hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('{{ deck.hero.image }}'); background-size: cover; background-position: center;">
        <div class="overlay"></div>
        <div class="deck-content">
            <img src="/img/logo_white_hq.png" alt="Misterio Color Lab" class="reveal">
            <h1 class="reveal">{{ deck.hero.title | safe }}</h1>
            <p class="reveal">{{ deck.hero.subtitle }}</p>
        </div>
    </section>

    <!-- Section 2: Services -->
    <section class="deck-section services-slide">
        <div class="container">
            <h2 class="reveal">Our Services</h2>
            <div class="services-wrapper detailed-grid">
                {% for service in deck.services %}
                <div class="service-slide-item reveal">
                    <h3>{{ service.title }}</h3>
                    <p>{{ service.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Section 3: Raúl Lavado -->
    <section class="deck-section talent-slide raul-slide">
        <div class="project-bg" style="background-image: url('{{ deck.sections.raul.project_image }}');"></div>
        <div class="talent-flex container">
            <div class="talent-photo reveal">
                <img src="/img/team/raul_lavado.jpg" alt="{{ deck.sections.raul.name }}">
            </div>
            <div class="talent-info reveal">
                <h2>{{ deck.sections.raul.name }}</h2>
                <h3 class="role-tag">{{ deck.sections.raul.role }}</h3>
                <div class="bio-placeholder">
                    <p>{{ deck.sections.raul.bio }}</p>
                </div>
                <div class="key-works">
                    <h4>Key Works</h4>
                    <ul id="raul-works">
                        {% for work in deck.sections.raul.works %}
                        <li>{{ work }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 4: Fady Melek -->
    <section class="deck-section talent-slide fady-slide">
        <div class="project-bg" style="background-image: url('{{ deck.sections.fady.project_image }}');"></div>
        <div class="talent-flex container">
            <div class="talent-photo reveal">
                <img src="/img/team/fady.jpg" alt="{{ deck.sections.fady.name }}">
            </div>
            <div class="talent-info reveal">
                <h2>{{ deck.sections.fady.name }}</h2>
                <h3 class="role-tag">{{ deck.sections.fady.role }}</h3>
                <div class="bio-placeholder">
                    <p>{{ deck.sections.fady.bio }}</p>
                </div>
                <div class="key-works">
                    <h4>Key Works</h4>
                    <ul>
                        {% for work in deck.sections.fady.works %}
                        <li>{{ work }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 5: Cem Ozkilicci -->
    <section class="deck-section talent-slide cem-slide">
        <div class="project-bg" style="background-image: url('{{ deck.sections.cem.project_image }}');"></div>
        <div class="talent-flex container">
            <div class="talent-photo reveal">
                <img src="/img/projects/cem_040.jpg" alt="{{ deck.sections.cem.name }}">
            </div>
            <div class="talent-info reveal">
                <h2>{{ deck.sections.cem.name }}</h2>
                <h3 class="role-tag">{{ deck.sections.cem.role }}</h3>
                <div class="bio-placeholder">
                    <p>{{ deck.sections.cem.bio }}</p>
                </div>
                <div class="key-works">
                    <h4>Key Works</h4>
                    <ul>
                        {% for work in deck.sections.cem.works %}
                        <li>{{ work }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 6: Closing -->
    <section class="deck-section closing-slide">
        <div class="deck-content container reveal">
            <h2>Let's shape your next story.</h2>
            <p>Ready to elevate your project with the Misterio touch?</p>
            <a href="/#contact" class="deck-btn">Talk to us</a>
        </div>
    </section>
</div>

<script>
    // Add specific class for the deck to hide main site UI if needed
    document.body.classList.add('deck-active');

    // Reveal animation on scroll for the deck
    const deckSections = document.querySelectorAll('.deck-section');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
            }
        });
    }, { threshold: 0.5 });

    deckSections.forEach(section => observer.observe(section));
</script>
