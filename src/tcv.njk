<style>
    .tcv-container {
        padding: 120px 20px 60px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }
    .tcv-header {
        text-align: center;
        margin-bottom: 50px;
    }
    .tcv-header h1 {
        font-family: 'Outfit', sans-serif;
        color: #fff;
        font-size: 2.5rem;
        margin-bottom: 10px;
    }
    .tcv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }
    .video-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 ratio */
        height: 0;
        overflow: hidden;
        border-radius: 8px;
        background: #111;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }
    
    @media (min-width: 900px) {
        .tcv-grid.featured {
            grid-template-columns: 1fr;
            max-width: 800px;
            margin: 0 auto 30px;
        }
        .tcv-grid.secondary {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

