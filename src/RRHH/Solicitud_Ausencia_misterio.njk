eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Solicitud de Ausencia RRHH - Misterio Color Lab</title>
  <style>
    :root {
      --bg: #0f1115;
      --panel: #171a21;
      --panel-2: #1d212b;
      --text: #f5f7fb;
      --muted: #aeb6c4;
      --accent: #ff6b1a;
      --line: #2b3140;
      --ok: #0ea56b;
      --bad: #d9534f;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(180deg, #0b0d11 0%, #12151c 100%);
      color: var(--text);
    }
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 20px 60px;
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 24px;
      align-items: start;
    }
    .card {
      background: rgba(23, 26, 33, 0.96);
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0,0,0,.28);
    }
    .sidebar {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      position: sticky;
      top: 32px;
    }
    .sidebar h3 {
      margin: 0 0 16px;
      font-size: 16px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .holiday-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .holiday-item {
      padding: 8px 0;
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      display: flex;
      justify-content: space-between;
      color: var(--muted);
    }
    .holiday-item:last-child { border-bottom: 0; }
    .holiday-item span { color: var(--text); font-weight: bold; }
    .holiday-item.local { color: #f9d976; }
    .header {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 20px;
      align-items: center;
      padding: 28px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(180deg, rgba(255,107,26,.06), rgba(255,107,26,0));
    }
    .logo {
      width: 160px;
      max-width: 100%;
      border-radius: 12px;
    }
    h1 {
      margin: 0 0 10px;
      font-size: 30px;
      letter-spacing: .02em;
    }
    .sub {
      color: var(--muted);
      line-height: 1.5;
      max-width: 780px;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 14px;
    }
    .pill {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 12px;
      color: var(--muted);
      font-size: 14px;
      background: var(--panel-2);
    }
    form {
      padding: 28px;
    }
    .section-title {
      font-size: 18px;
      margin: 0 0 16px;
      color: var(--accent);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 26px;
    }
    .full { grid-column: 1 / -1; }
    label {
      display: block;
      font-size: 14px;
      margin-bottom: 8px;
      color: #dfe5ef;
      font-weight: bold;
    }
    input, select, textarea {
      width: 100%;
      border: 1px solid var(--line);
      background: #11141a;
      color: var(--text);
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 15px;
      outline: none;
    }
    textarea {
      min-height: 110px;
      resize: vertical;
    }
    input[readonly] {
      background: #0c0f14;
      color: #c9d0dc;
      cursor: not-allowed;
    }
    .checks {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .check {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border: 1px solid var(--line);
      background: #11141a;
      border-radius: 12px;
    }
    .check input {
      width: auto;
      margin: 0;
      accent-color: var(--accent);
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 8px;
    }
    button {
      border: 0;
      border-radius: 12px;
      padding: 13px 18px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }
    .primary {
      background: var(--accent);
      color: white;
    }
    .secondary {
      background: #242a36;
      color: white;
      border: 1px solid var(--line);
    }
    .status {
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 12px;
      display: none;
      font-size: 14px;
      line-height: 1.5;
    }
    .status.ok {
      display: block;
      background: rgba(14,165,107,.12);
      border: 1px solid rgba(14,165,107,.35);
      color: #bdf1dd;
    }
    .status.err {
      display: block;
      background: rgba(217,83,79,.12);
      border: 1px solid rgba(217,83,79,.35);
      color: #ffd7d5;
    }
    .footer-note {
      color: var(--muted);
      font-size: 13px;
      margin-top: 18px;
      line-height: 1.6;
    }
    @media (max-width: 1024px) {
      .wrap {
        grid-template-columns: 1fr;
      }
      .sidebar {
        position: static;
        order: 2;
      }
    }
    @media (max-width: 760px) {
      .header {
        grid-template-columns: 1fr;
      }
      .grid, .checks {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="header">
        <img class="logo" src="/img/logo_white_hq.png" alt="Misterio Color Lab">
        <div>
          <h1>Solicitud de Ausencia</h1>
          <div class="sub">
            Formulario interno para la gestión de ausencias. El número de días se calcula automáticamente excluyendo festivos y fines de semana.
          </div>
          <div class="meta">
            <div class="pill">Empresa: Misterio Color Lab</div>
            <div class="pill">Destino: administracion@misteriocolorlab.com</div>
            <div class="pill">Estado inicial: Pendiente</div>
          </div>
        </div>
      </div>

      <form id="absenceForm">
        <h2 class="section-title">Datos de la solicitud</h2>
        <div class="grid">
          <div>
            <label for="requestId">Número de solicitud</label>
            <input id="requestId" name="requestId" readonly />
          </div>
          <div>
            <label for="requestDate">Fecha de solicitud</label>
            <input id="requestDate" name="requestDate" type="date" required />
          </div>
          <div>
            <label for="employeeName">Nombre del empleado</label>
            <input id="employeeName" name="employeeName" required />
          </div>
          <div>
            <label for="department">Departamento</label>
            <input id="department" name="department" required />
          </div>
          <div>
            <label for="position">Puesto</label>
            <input id="position" name="position" />
          </div>
          <div>
            <label for="manager">Responsable directo</label>
            <input id="manager" name="manager" />
          </div>
          <div>
            <label for="startDate">Fecha inicio</label>
            <input id="startDate" name="startDate" type="date" required />
          </div>
          <div>
            <label for="endDate">Fecha fin</label>
            <input id="endDate" name="endDate" type="date" required />
          </div>
          <div>
            <label for="days">Número de días (Laborables)</label>
            <input id="days" name="days" type="number" min="0" step="0.5" readonly />
          </div>
          <div>
            <label for="statusField">Estado</label>
            <select id="statusField" name="statusField">
              <option value="Pendiente" selected>Pendiente</option>
              <option value="Aprobado">Aprobado</option>
              <option value="Rechazado">Rechazado</option>
            </select>
          </div>

          <div class="full">
            <label>Tipo de ausencia</label>
            <div class="checks">
              <label class="check"><input type="radio" name="absenceType" value="Vacaciones" required /> Vacaciones</label>
              <label class="check"><input type="radio" name="absenceType" value="Enfermedad" /> Enfermedad</label>
              <label class="check"><input type="radio" name="absenceType" value="Personal" /> Personal</label>
              <label class="check"><input type="radio" name="absenceType" value="Otro" /> Otro</label>
            </div>
          </div>

          <div class="full">
            <label for="reason">Motivo de la solicitud</label>
            <textarea id="reason" name="reason" required></textarea>
          </div>

          <div class="full">
            <label for="hrComments">Comentarios de RRHH</label>
            <textarea id="hrComments" name="hrComments" placeholder="Uso interno de RRHH"></textarea>
          </div>
        </div>

        <div class="actions">
          <button type="button" class="primary" id="finalizeBtn">Enviar Solicitud (Abrir Correo)</button>
          <button type="button" class="secondary" id="copyBtn">Copiar Datos (Manual)</button>
          <button type="button" class="secondary" id="downloadBtn">Descargar Copia (.txt)</button>
          <button type="reset" class="secondary">Limpiar Campos</button>
        </div>

        <div id="statusBox" class="status"></div>
      </form>
    </div>

    <div class="sidebar">
      <h3>Festivos Madrid 2026</h3>
      <ul class="holiday-list">
        <li class="holiday-item">Año Nuevo <span>1 Ene</span></li>
        <li class="holiday-item">Epifanía del Señor <span>6 Ene</span></li>
        <li class="holiday-item">Jueves Santo <span>2 Abr</span></li>
        <li class="holiday-item">Viernes Santo <span>3 Abr</span></li>
        <li class="holiday-item">Día del Trabajador <span>1 May</span></li>
        <li class="holiday-item">Comunidad de Madrid <span>2 May</span></li>
        <li class="holiday-item local">San Isidro (Madrid) <span>15 May</span></li>
        <li class="holiday-item">Asunción de la Virgen <span>15 Ago</span></li>
        <li class="holiday-item">Fiesta Nacional <span>12 Oct</span></li>
        <li class="holiday-item">Todos los Santos (tr.) <span>2 Nov</span></li>
        <li class="holiday-item local">La Almudena (Madrid) <span>9 Nov</span></li>
        <li class="holiday-item">Constitución (tr.) <span>7 Dic</span></li>
        <li class="holiday-item">Inmaculada <span>8 Dic</span></li>
        <li class="holiday-item">Navidad <span>25 Dic</span></li>
      </ul>
      <p style="font-size: 11px; margin-top: 15px; color: var(--muted);">
        * Los festivos locales corresponden al municipio de Madrid (San Isidro y Almudena).
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('absenceForm');
    const requestId = document.getElementById('requestId');
    const requestDate = document.getElementById('requestDate');
    const startDate = document.getElementById('startDate');
    const endDate = document.getElementById('endDate');
    const daysInput = document.getElementById('days');
    const statusBox = document.getElementById('statusBox');

    // Madrid 2026 Holidays (YYYY-MM-DD)
    const madridHolidays2026 = [
      '2026-01-01', '2026-01-06', '2026-04-02', '2026-04-03',
      '2026-05-01', '2026-05-02', '2026-05-15', '2026-08-15',
      '2026-10-12', '2026-11-02', '2026-11-09', '2026-12-07',
      '2026-12-08', '2026-12-25'
    ];

    function calculateBusinessDays() {
      const start = new Date(startDate.value);
      const end = new Date(endDate.value);

      if (!startDate.value || !endDate.value || isNaN(start) || isNaN(end)) {
        daysInput.value = 0;
        return;
      }

      if (end < start) {
        daysInput.value = 0;
        return;
      }

      let count = 0;
      let current = new Date(start);
      
      while (current <= end) {
        const dayOfWeek = current.getDay();
        const dateString = current.toISOString().split('T')[0];
        
        // Check if it's NOT a weekend (0=Sun, 6=Sat) AND NOT a holiday
        if (dayOfWeek !== 0 && dayOfWeek !== 6 && !madridHolidays2026.includes(dateString)) {
          count++;
        }
        
        current.setDate(current.getDate() + 1);
      }
      
      daysInput.value = count;
    }

    startDate.addEventListener('change', calculateBusinessDays);
    endDate.addEventListener('change', calculateBusinessDays);

    function generateRequestId() {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth()+1).padStart(2,'0');
      const d = String(now.getDate()).padStart(2,'0');
      const hh = String(now.getHours()).padStart(2,'0');
      const mm = String(now.getMinutes()).padStart(2,'0');
      const ss = String(now.getSeconds()).padStart(2,'0');
      return `SA-${y}${m}${d}-${hh}${mm}${ss}`;
    }

    function setDefaults() {
      requestId.value = generateRequestId();
      requestDate.value = new Date().toISOString().slice(0,10);
      statusBox.className = 'status';
      statusBox.textContent = '';
      calculateBusinessDays();
    }

    function formDataObject() {
      const data = new FormData(form);
      const obj = {};
      for (const [k, v] of data.entries()) {
          obj[k] = v;
      }
      return obj;
    }

    function showStatus(type, msg) {
      statusBox.className = 'status ' + type;
      statusBox.textContent = msg;
    }

    function buildEmailBody(d) {
      return [
        '--- SOLICITUD DE AUSENCIA MISTERIO COLOR LAB ---',
        '',
        'ID SOLICITUD: ' + (d.requestId || ''),
        'FECHA: ' + (d.requestDate || ''),
        '------------------------------------------------',
        'EMPLEADO: ' + (d.employeeName || ''),
        'DEPARTAMENTO: ' + (d.department || ''),
        'PUESTO: ' + (d.position || ''),
        'RESPONSABLE: ' + (d.manager || ''),
        '',
        'DETALLES:',
        'TIPO: ' + (d.absenceType || 'No especificado'),
        'INICIO: ' + (d.startDate || ''),
        'FIN: ' + (d.endDate || ''),
        'DIAS LABORABLES: ' + (d.days || ''),
        'ESTADO: ' + (d.statusField || 'Pendiente'),
        '',
        'MOTIVO:',
        (d.reason || ''),
        '',
        'COMENTARIOS RRHH:',
        (d.hrComments || 'Sin comentarios'),
        '',
        '------------------------------------------------'
      ].join('\r\n');
    }

    document.getElementById('finalizeBtn').addEventListener('click', () => {
      if (!form.reportValidity()) {
         showStatus('err', 'Por favor, rellena los campos obligatorios.');
         return;
      }
      
      const d = formDataObject();
      const subject = `Solicitud Ausencia: ${d.employeeName} (${d.requestId})`;
      const body = buildEmailBody(d);
      const adminEmail = 'administracion@misteriocolorlab.com';
      
      const mailtoLink = `mailto:${adminEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      
      // Intentar abrir el correo
      window.location.href = mailtoLink;
      
      showStatus('ok', 'Intentando abrir tu programa de correo... Si no ocurre nada, pulsa el boton "Copiar Datos" para pegarlos manualmente en un email a administracion@misteriocolorlab.com');
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      if (!form.reportValidity()) {
         showStatus('err', 'Por favor, rellena los campos obligatorios.');
         return;
      }
      const d = formDataObject();
      const body = buildEmailBody(d);
      
      navigator.clipboard.writeText(body).then(() => {
        showStatus('ok', '¡Contenido copiado al portapapeles! Ahora puedes pegarlo directamente en un email nuevo para administracion@misteriocolorlab.com');
      }).catch(err => {
        showStatus('err', 'No se pudo copiar automaticamente. Por favor, descarga el .txt y copia el contenido.');
      });
    });

    document.getElementById('downloadBtn').addEventListener('click', () => {
      if (!form.reportValidity()) return;
      const d = formDataObject();
      const blob = new Blob([buildEmailBody(d)], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${d.requestId || 'solicitud'}.txt`;
      a.click();
      showStatus('ok', 'Copia descargada correctamente.');
    });

    form.addEventListener('reset', () => {
      setTimeout(setDefaults, 0);
    });

    setDefaults();
  </script>
</body>
</html>
