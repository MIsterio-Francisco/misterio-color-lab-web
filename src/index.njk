---
layout: layouts/base.njk
title: Misterio Color Lab | Color Grading in Madrid & Etalonaje Digital
seo_description: "Estudio boutique de postproducción audiovisual y etalonaje digital en Madrid. Boutique color grading studio in Madrid specializing in high-end finishing for films and commercials."
---
<!-- Hero Section -->
    <header class="hero" id="home">
        <div class="hero-bg">
            <video autoplay loop muted playsinline id="hero-video">
                <source src="/img/video/reel.mp4" type="video/mp4">
            </video>
        </div>
        <div class="hero-content reveal">
            <h1 style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;">Misterio Color Lab - Premier Color Grading Studio in Madrid & Etalonaje Digital</h1>
            <img src="img/logo_white_hq.png" alt="Misterio Color Lab" class="hero-logo">
            <p class="hero-subtitle" id="cms-hero_subtitle">Specialists in color grading and finishing for films,
                documentaries, and commercials worldwide.</p>
        </div>

        <!-- Poster Carousel -->
        <div class="poster-carousel">
            <div class="poster-track" id="poster-track">
                <!-- Posters injected by JS -->
            </div>
        </div>

        <div class="scroll-indicator">
            <span>Scroll</span>
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </header>



    <!-- Client Logos Carousel -->
    <section class="client-carousel">
        <div class="container">
            <div class="logos-wrapper">
                <div class="logos-track">
                    <!-- Set 1 -->
                    <div class="logo-item"><img src="/img/logos/netflix.png" alt="Netflix"></div>
                    <div class="logo-item"><img src="/img/logos/disneyplus.png" alt="Disney+"></div>
                    <div class="logo-item"><img src="/img/logos/primevideo.png" alt="Prime Video"></div>
                    <div class="logo-item"><img src="/img/logos/starplus.svg" alt="Star+"></div>
                    <div class="logo-item"><img src="/img/logos/max.svg" alt="Max"></div>
                    <div class="logo-item"><img src="/img/logos/vix.svg" alt="VIX"></div>
                    <div class="logo-item"><img src="/img/logos/rtve.png" alt="RTVE"></div>
                    <!-- Logos updated by User -->
                    <div class="logo-item"><img src="/img/logos/atresmediacine.jpg" alt="Atresmedia Cine"></div>
                    <div class="logo-item"><img src="/img/logos/arri.png" alt="Arri"></div>
                    <div class="logo-item"><img src="/img/logos/wildhouse.png" alt="Wildhouse Pictures" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/nostromo.svg" alt="Nostromo Pictures" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/laposta.png" alt="La Posta" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/sonymusic.png" alt="Sony Music"></div>
                    <div class="logo-item"><img src="/img/logos/cattleya.png" alt="Cattleya"></div>
                    <div class="logo-item"><img src="/img/logos/lacanica.png" alt="La Canica"></div>
                    <div class="logo-item"><img src="/img/logos/elsuenoeterno.png" alt="El Sueño Eterno"></div>
                    <div class="logo-item"><img src="/img/logos/katara.png" alt="Katara Studios"></div>
                    
                    <!-- Set 2 (Duplicate for loop) -->
                    <div class="logo-item"><img src="/img/logos/netflix.png" alt="Netflix"></div>
                    <div class="logo-item"><img src="/img/logos/disneyplus.png" alt="Disney+"></div>
                    <div class="logo-item"><img src="/img/logos/primevideo.png" alt="Prime Video"></div>
                    <div class="logo-item"><img src="/img/logos/starplus.svg" alt="Star+"></div>
                    <div class="logo-item"><img src="/img/logos/max.svg" alt="Max"></div>
                    <div class="logo-item"><img src="/img/logos/vix.svg" alt="VIX"></div>
                    <div class="logo-item"><img src="/img/logos/rtve.png" alt="RTVE"></div>
                    <!-- Logos updated by User (Set 2) -->
                    <div class="logo-item"><img src="/img/logos/atresmediacine.jpg" alt="Atresmedia Cine"></div>
                    <div class="logo-item"><img src="/img/logos/arri.png" alt="Arri"></div>
                    <div class="logo-item"><img src="/img/logos/wildhouse.png" alt="Wildhouse Pictures" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/nostromo.svg" alt="Nostromo Pictures" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/laposta.png" alt="La Posta" class="logo-special"></div>
                    <div class="logo-item"><img src="/img/logos/sonymusic.png" alt="Sony Music"></div>
                    <div class="logo-item"><img src="/img/logos/cattleya.png" alt="Cattleya"></div>
                    <div class="logo-item"><img src="/img/logos/lacanica.png" alt="La Canica"></div>
                    <div class="logo-item"><img src="/img/logos/elsuenoeterno.png" alt="El Sueño Eterno"></div>
                    <div class="logo-item"><img src="/img/logos/katara.png" alt="Katara Studios"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Long Form Sneak Peek -->
    <section class="work-section sneak-peek" id="home-long-form" style="padding-top: 4rem; padding-bottom: 2rem;">
        <div class="container">
            <div class="section-header reveal">
                <h2 class="section-title">Long Form</h2>
                <div class="section-line"></div>
            </div>
            <div class="poster-grid" id="gallery-grid-home">
                <!-- Injected by JS -->
            </div>
            <div style="text-align: center; margin-top: 3rem;">
                <a href="/long-form/" class="btn btn-outline" style="border: 1px solid var(--color-accent); color: white; padding: 0.8rem 2rem; border-radius: 30px; text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.3s ease;">View All Long Form</a>
            </div>
        </div>
    </section>

    <!-- Branded Content Sneak Peek -->
    <section class="work-section sneak-peek" id="home-tvc" style="padding-top: 4rem; padding-bottom: 6rem;">
        <div class="container">
            <div class="section-header reveal">
                <h2 class="section-title">Branded Content</h2>
                <div class="section-line"></div>
            </div>
            <div class="tvc-row-grid" id="tcv-grid-home">
                {% for video in tvc.videos %}
                {% if loop.index0 < 4 %}
                <div class="video-card-premium reveal" style="width: 100%; height: 100%; cursor: pointer;" data-title="{{ video.title | escape }}" data-video="https://www.youtube.com/watch?v={{ video.youtube_id }}" onclick="window.openProjectModal({title: this.getAttribute('data-title'), video: this.getAttribute('data-video')})">
                    <div class="video-container-premium" style="position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 8px;">
                        <div class="showreel-thumb-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: url('https://img.youtube.com/vi/{{ video.youtube_id }}/maxresdefault.jpg'); background-size: cover; background-position: center; transition: transform 0.5s ease;">
                            <div class="play-icon-large" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 40px; height: 40px; background: rgba(0,0,0,0.6); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; transition: all 0.3s ease;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        </div>
                        <div class="glass-overlay" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 1rem; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); color: white; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0; transition: opacity 0.3s ease;">
                            {{ video.title }}
                        </div>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            <div style="text-align: center; margin-top: 3rem;">
                <a href="/tvc/" class="btn btn-outline" style="border: 1px solid var(--color-accent); color: white; padding: 0.8rem 2rem; border-radius: 30px; text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.3s ease;">View All Branded Content</a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section" id="contact">
        <div class="container">
            <div class="contact-box reveal">
                <h2 class="section-title text-center" data-i18n="contact_title">Color Grading Worldwide</h2>
                <div class="section-line center-line"></div>
                <p class="contact-subtitle" data-i18n="contact_subtitle">Looking for high-end color grading in Madrid, Mexico City, Sao Paulo, or Oslo? Let's craft the final cinematic touch your project deserves.</p>

                <div class="contact-grid">
                    <div class="contact-info">
                        <div class="info-block">
                            <h4 data-i18n="location_madrid">Madrid - ESPAÑA</h4>
                            <p>C. de Albasanz, 59<br>San Blas-Canillejas, 28037</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_mexico">Mexico City - MEXICO</h4>
                            <p>Goethe 39, Anzures</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_saopaulo">Sao Paulo - BRASIL</h4>
                            <p>Rua Sebastião Stokler 21</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_oslo">Oslo - NORUEGA</h4>
                            <p>Oscars gate 27, 0352 Oslo</p>
                        </div>

                        <div class="info-block contact-details">
                            <p><a href="tel:+34638862751">+34 638 862751</a></p>
                            <p><a href="mailto:info@misteriocolorlab.com">info@misteriocolorlab.com</a></p>
                        </div>
                    </div>

                    <form id="contact-form" class="contact-form" name="contact" method="POST" action="/success.html" data-netlify="true" data-netlify-honeypot="bot-field">
                        <input type="hidden" name="form-name" value="contact" />
                        <p class="hidden" style="display:none;">
                            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
                        </p>
                        <div class="form-group">
                            <input type="text" id="name" name="name" placeholder="Your Name"
                                data-i18n-hold="form_name" required>
                        </div>
                        <div class="form-group">
                            <input type="email" id="email" name="email" placeholder="Email Address"
                                data-i18n-hold="form_email" required>
                        </div>
                        <div class="form-group">
                            <input type="tel" id="phone" name="phone" placeholder="Phone Number"
                                data-i18n-hold="form_phone" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-submit" data-i18n="form_submit">Request a Post-Production Quote</button>
                    </form>
                </div>
            </div>
        </div>
    </section>