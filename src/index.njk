---
layout: layouts/base.njk
title: Misterio Color Lab
---
<!-- Hero Section -->
    <header class="hero" id="home">
        <div class="hero-bg"></div>
        <div class="hero-content reveal">
            <img src="img/logo_white_hq.png" alt="Misterio Color Lab" class="hero-logo">
            <p class="hero-subtitle" id="cms-hero_subtitle">Specialists in color grading and finishing for films,
                documentaries, and commercials worldwide.</p>
        </div>

        <!-- Poster Carousel -->
        <div class="poster-carousel">
            <div class="poster-track" id="poster-track">
                <!-- Posters injected by JS -->
            </div>
        </div>

        <div class="scroll-indicator">
            <span>Scroll</span>
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </header>

    <!-- Team Section -->
    <section class="team-section" id="team">
        <div class="container">
            <div class="section-header reveal">
                <h2 class="section-title text-center" data-i18n="section_team">Our Team</h2>
                <div class="section-line center-line"></div>
            </div>

            <div class="team-rows">
                <div class="team-grid team-row-top" id="cms-team-row-top">
                    <!-- Top row (Lead Team) -->
                </div>
                <div class="team-grid team-row-bottom" id="cms-team-row-bottom">
                    <!-- Bottom row (Operations/Junior) -->
                </div>
            </div>
        </div>
    </section>


    <!-- Work / Gallery Section -->
    <section class="work-section" id="work">
        <div class="container">
            <div class="section-header reveal">
                <h2 class="section-title" data-i18n="section_work">Featured Projects</h2>
                <div class="section-line"></div>
            </div>

            <!-- Dynamic Gallery Grid -->
            <div class="gallery-grid" id="gallery-grid">
                <!-- Injected by JS -->
            </div>
        </div>
    </section>

    <!-- Studio / About Section -->
    <section class="about-section" id="about">
        <div class="container">
            <div class="about-grid">
                <div class="about-text reveal">
                    <h2 class="section-title" data-i18n="section_studio">The Studio</h2>
                    <div class="section-line"></div>
                    <p id="cms-studio_text_1">Misterio Color Lab is a post-production boutique specializing in color
                        grading and finishing. We believe in the power of color to tell stories, conveying the exact
                        emotion in every frame.</p>
                    <p id="cms-studio_text_2">Our approach combines cutting-edge technology with a unique artistic
                        vision, working closely with directors and cinematographers to achieve their ultimate vision.
                    </p>

                    <div class="services-list" id="cms-services-list">
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">Integrated Digital Lab</span>
                        </div>
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">Color Grading & HDR</span>
                        </div>
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">Mastering & Deliveries</span>
                        </div>
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">Sound Design & Mix</span>
                        </div>
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">VFX & Compositing</span>
                        </div>
                        <div class="service-item">
                            <span class="service-icon">✦</span>
                            <span class="service-name">Post-production Supervision</span>
                        </div>
                    </div>
                </div>
                <div class="about-visual reveal">
                    <div class="visual-placeholder">
                        <img src="/img/logo_white.png" alt="Misterio Color Lab" class="studio-placeholder-logo">
                        <span class="visual-text">COMING SOON</span>
                    </div>
                </div>

            </div>
        </div>
    </section>



    <!-- Contact Section -->
    <section class="contact-section" id="contact">
        <div class="container">
            <div class="contact-box reveal">
                <h2 class="section-title text-center" data-i18n="contact_title">Contact Us</h2>
                <div class="section-line center-line"></div>
                <p class="contact-subtitle" data-i18n="contact_subtitle">Have a project in mind? Let's talk about how we
                    can give it the final touch it deserves.</p>

                <div class="contact-grid">
                    <div class="contact-info">
                        <div class="info-block">
                            <h4 data-i18n="location_madrid">Madrid - ESPAÑA</h4>
                            <p>C. de Albasanz, 59<br>San Blas-Canillejas, 28037</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_mexico">Mexico City - MEXICO</h4>
                            <p>Goethe 39, Anzures</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_saopaulo">Sao Paulo - BRASIL</h4>
                            <p>Rua Sebastião Stokler 21</p>
                        </div>
                        <div class="info-block">
                            <h4 data-i18n="location_oslo">Oslo - NORUEGA</h4>
                            <p>Oscars gate 27, 0352 Oslo</p>
                        </div>

                        <div class="info-block contact-details">
                            <p><a href="tel:+34638862751">+34 638 862751</a></p>
                            <p><a href="mailto:info@misteriocolorlab.com">info@misteriocolorlab.com</a></p>
                        </div>
                    </div>

                    <form id="contact-form" class="contact-form" name="contact" method="POST" action="/success.html" data-netlify="true" data-netlify-honeypot="bot-field">
                        <input type="hidden" name="form-name" value="contact" />
                        <p class="hidden" style="display:none;">
                            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
                        </p>
                        <div class="form-group">
                            <input type="text" id="name" name="name" placeholder="Your Name"
                                data-i18n-hold="form_name" required>
                        </div>
                        <div class="form-group">
                            <input type="email" id="email" name="email" placeholder="Email Address"
                                data-i18n-hold="form_email" required>
                        </div>
                        <div class="form-group">
                            <input type="tel" id="phone" name="phone" placeholder="Phone Number"
                                data-i18n-hold="form_phone" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-submit" data-i18n="form_submit">Request Quote</button>
                    </form>
                </div>
            </div>
        </div>
    </section>