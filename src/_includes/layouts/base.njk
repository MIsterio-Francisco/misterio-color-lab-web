<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set pageTitle = title if (title and "Misterio Color Lab" in title) else (title + " — " + site.name if title else site.name) %}
    {% set pageDesc = seo_description | default(site.description) %}
    {% set rawImage = seo_image | default(site.image) %}
    {% set pageImage = rawImage if (rawImage.startsWith('http://') or rawImage.startsWith('https://')) else (site.url + (rawImage if rawImage.startsWith('/') else '/' + rawImage)) %}
    {% set currentUrl = site.url + page.url %}

    <!-- Standard Meta Tags -->
    <meta name="description" content="{{ pageDesc }}">
    <title>{{ pageTitle }}</title>
    <link rel="canonical" href="{{ currentUrl }}">
    {% if page.url == '/en/' or page.url == '/es/' %}
    <link rel="alternate" hreflang="en" href="{{ site.url }}/en/">
    <link rel="alternate" hreflang="es" href="{{ site.url }}/es/">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/en/">
    <link rel="preload" as="image" href="/img/video/web/reel-poster.webp" fetchpriority="high">
    {% endif %}
    <link rel="icon" href="/img/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/img/favicon-32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

    <!-- Open Graph (Facebook/LinkedIn) -->
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDesc }}">
    <meta property="og:type" content="{{ og_type | default('website') }}">
    <meta property="og:url" content="{{ currentUrl }}">
    <meta property="og:image" content="{{ pageImage }}">
    <meta property="og:image:alt" content="{{ pageTitle }}">
    <meta property="og:locale" content="{{ 'es_ES' if lang == 'es' else 'en_US' }}">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ site.social.twitter }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDesc }}">
    <meta name="twitter:image" content="{{ pageImage }}">
    <meta name="twitter:image:alt" content="{{ pageTitle }}">

    <!-- LocalBusiness & Organization schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "name": "Misterio Color Lab",
      "url": "https://misteriocolorlab.com",
      "inLanguage": "{{ lang | default('en') }}",
      "logo": "https://misteriocolorlab.com/img/logo_white_hq.png",
      "image": "https://misteriocolorlab.com/img/logo_white_hq.png",
      "description": "{{ pageDesc }}",
      "priceRange": "€€€",
      "areaServed": ["ES", "MX", "BR", "NO"],
      "knowsAbout": ["Color grading", "Digital intermediate", "HDR finishing", "Digital mastering", "Post-production"],
      "sameAs": ["https://www.instagram.com/misteriocolorlab/"],
      "telephone": "+34638862751",
      "email": "info@misteriocolorlab.com",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Calle San Sotero #6",
          "addressLocality": "Madrid",
          "addressRegion": "Madrid",
          "postalCode": "28037",
          "addressCountry": "ES"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Goethe 39, Anzures",
          "addressLocality": "Mexico City",
          "addressCountry": "MX"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Rua Sebastião Stokler 21",
          "addressLocality": "Sao Paulo",
          "addressCountry": "BR"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Oscars gate 27",
          "addressLocality": "Oslo",
          "postalCode": "0352",
          "addressCountry": "NO"
        }
      ]
    }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css?v=20260820">
    <!-- intl-tel-input CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@21.2.7/build/css/intlTelInput.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@21.2.7/build/css/intlTelInput.css"></noscript>
    <!-- Netlify Identity Widget -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
</head>
<body data-lang="{{ lang | default('en') }}">
    <!-- Navbar -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <div class="brand-group">
                <a href="/" class="brand-logo">
                    <img src="/img/logo_white.png" alt="Misterio Color Lab" class="brand-logo-img">
                </a>
                <a href="#" class="brand-logo dolores-logo-link">
                    <img src="/img/logos/dolores_logo.png" alt="Dolores" class="brand-logo-img dolores-logo-img">
                </a>
            </div>

            <div class="nav-right">
                <ul class="nav-links">
                    <li><a href="/team/" class="nav-link" data-i18n="nav_team" id="cms-nav_team">{{ 'Nuestro Equipo' if lang == 'es' else 'Our Team' }}</a></li>
                    <li><a href="/long-form/" class="nav-link" data-i18n="nav_long_form" id="cms-nav_long_form">{{ 'Proyectos' if lang == 'es' else 'Long Form' }}</a></li>
                    <li><a href="/tvc/" class="nav-link" data-i18n="nav_branded" id="cms-nav_branded">Branded Content</a></li>
                    <li><a href="/services/" class="nav-link" data-i18n="nav_studio" id="cms-nav_studio">{{ 'Estudio' if lang == 'es' else 'Studio' }}</a></li>
                    <li><a href="/{{ lang | default('en') }}/#contact" class="nav-link" data-i18n="nav_contact" id="cms-nav_contact">{{ 'Contacto' if lang == 'es' else 'Contact' }}</a></li>
                </ul>

                <div class="lang-toggle">
                    <a href="/en/" id="lang-en" class="lang-btn{% if lang != 'es' %} active{% endif %}" lang="en" hreflang="en">EN</a>
                    <span class="separator">|</span>
                    <a href="/es/" id="lang-es" class="lang-btn{% if lang == 'es' %} active{% endif %}" lang="es" hreflang="es">ES</a>
                </div>

                <div class="hamburger">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </div>
            </div>
        </div>
    </nav>

    {% if page.url != '/' %}
    <div class="return-home-wrapper">
        <a href="/" class="btn-return-home" data-i18n="back_home">← Back to Home</a>
    </div>
    {% endif %}

    {{ content | safe }}

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-content">
            <div class="footer-brand-container">
                <div class="footer-brand">
                    <div class="brand-group left">
                        <img src="/img/logos/christie_logo.png" alt="Christie" class="partner-logo christie-logo">
                        <img src="/img/logos/filmlight_logo.png" alt="FilmLight" class="partner-logo filmlight-logo">
                        <img src="/img/logos/dolores_logo.png" alt="Dolores" class="partner-logo dolores-logo-footer">
                    </div>
                    <div class="brand-group center">
                        <img src="/img/logo_white.png" alt="Misterio Color Lab" class="footer-logo-main">
                    </div>
                    <div class="brand-group right">
                        <img src="/img/logos/madrid.png" alt="Comunidad de Madrid" class="institution-logo gov-logo">
                        <img src="/img/logos/resiliencia.png" alt="Plan de Recuperación, Transformation y Resiliencia" class="institution-logo gov-logo resiliencia-logo">
                        <img src="/img/logos/nextgen.png" alt="Next Generation EU" class="institution-logo nextgen-logo">
                    </div>
                </div>
                <p class="footer-desc" id="cms-footer_description" data-i18n="footer_description">Boutique Color Grading Studio based in Madrid.</p>
            </div>


        
        </div>
        <div class="footer-bottom">
            <p>&copy; <span id="current-year"></span> Misterio Color Lab. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <!-- Content Data Mapping -->
    <script>
        {% raw %}window.cmsData = window.cmsData || {};{% endraw %}
    </script>
    <!-- Enhanced Project Modal (Global) -->
    <div class="video-modal" id="videoModal">
        <button class="close-modal" aria-label="Close modal">
            <span class="close-icon">&times;</span>
            <span class="close-text" style="display: none;">&larr; Back</span>
        </button>
        <div class="modal-content expanded-modal">
            <div class="modal-left">
                <div class="iframe-container" id="iframeContainer"></div>
            </div>
            <div class="modal-right">
                <div class="modal-project-details">
                    <span class="project-category" id="modal-category">Category</span>
                    <h2 class="project-title" id="modal-title">Project Title</h2>
                    <p class="project-director" id="modal-director">Director Name</p>
                    <div id="modal-attribution" class="modal-attribution"></div>
                    <div class="modal-synopsis">
                        <p id="modal-synopsis"></p>
                    </div>
                    <div class="modal-stills" id="modal-stills-container">
                        <!-- Stills will be injected here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@21.2.7/build/js/intlTelInput.min.js"></script>
    <script src="/js/i18n.js"></script>
    <script src="/js/cms-settings.js"></script>
    <script src="/js/main.js?v=20260820"></script>
</body>
</html>
