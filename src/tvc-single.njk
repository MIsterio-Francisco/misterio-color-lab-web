---
layout: layouts/base.njk
pagination:
  data: tvcVideos
  size: 1
  alias: video
permalink: "/tvc/{{ video.slug }}/"
eleventyComputed:
  title: "{{ video.title }} — Misterio Color Lab"
  seo_description: "{{ video.cleanSynopsis | striptags | truncate(160) }}"
  seo_image: "{{ video.image }}"
---

<link rel="stylesheet" href="/css/deck.css">

<div class="deck-container" style="padding-top: 8rem; padding-bottom: 6rem; min-height: 85vh; background: #050505;">
    <div class="film-grain"></div>
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 2;">
        
        <div style="margin-bottom: 2rem;">
            <a href="/tvc/" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--deck-accent, #c9a96e); text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Back to Branded Content
            </a>
        </div>

        <div style="display: grid; grid-template-columns: minmax(300px, 500px) 1fr; gap: 3.5rem; align-items: start; margin-top: 2rem;">
            
            <!-- Video Thumbnail Card -->
            <div class="video-card-premium" style="width: 100%; cursor: pointer;" onclick="triggerTvcModal()">
                <div class="video-container-premium" style="position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; border-radius: 12px; box-shadow: 0 20px 40px rgba(0,0,0,0.7);">
                    <div class="showreel-thumb-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: url('{{ video.image }}'); background-size: cover; background-position: center;">
                        <div class="play-icon-large" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60px; height: 60px; background: rgba(0,0,0,0.7); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Details -->
            <div>
                <span style="display: inline-block; padding: 0.3rem 0.8rem; background: rgba(201, 169, 110, 0.15); border: 1px solid rgba(201, 169, 110, 0.4); color: #c9a96e; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em; border-radius: 20px; margin-bottom: 1rem;">
                    BRANDED CONTENT / COMMERCIAL
                </span>

                <h1 style="font-size: 2.5rem; color: #fff; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.5rem; line-height: 1.2;">
                    {{ video.title }}
                </h1>

                {% if video.credits_html %}
                    <div style="font-size: 1.05rem; line-height: 1.9; color: #ccc; margin-bottom: 2.5rem; padding: 1.5rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;">
                        {{ video.credits_html | safe }}
                    </div>
                {% endif %}

                <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                    <button onclick="triggerTvcModal()" style="background: #c9a96e; color: #000; padding: 0.9rem 2rem; border: none; border-radius: 30px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        Watch Video
                    </button>
                    <a href="/tvc/" class="deck-btn-premium" style="background: transparent; border: 1px solid rgba(255, 255, 255, 0.3); color: #fff; padding: 0.9rem 2rem; border-radius: 30px; text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;">
                        All Branded Content
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    const currentVideo = {
        title: {{ video.title | dump | safe }},
        video: {{ video.video_url | dump | safe }},
        synopsis: {{ video.credits_html | dump | safe }},
        id: {{ video.slug | dump | safe }}
    };

    function triggerTvcModal() {
        if (window.openProjectModal) {
            window.openProjectModal(currentVideo);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            if (currentVideo && window.openProjectModal) {
                window.openProjectModal(currentVideo);
            }
        }, 300);
    });
</script>
